{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "'Courier Prime', serif",
					"slug": "courier-prime",
					"name": "Courier Prime"
				},
				{
					"fontFamily": "'Anton', serif",
					"slug": "anton",
					"name": "Anton"
				},
				{
					"fontFamily": "'Newsreader', serif",
					"slug": "newsreader",
					"name": "Newsreader"
				}
			]
		},
		"custom": {
			"latest-news": {
				"title": {
					"fontFamily": "var(--wp--preset--font-family--inter)",
					"fontWeight": "600",
					"fontSize": "18px",
					"lineHeight": 1.3
				}
			}
		}
	},
	"styles": {
		"blocks": {
			"wporg/download-counter": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--monospace)",
					"fontSize": "clamp(40px, calc(100vw / 8), 120px)",
					"lineHeight": "1"
				}
			}
		}
	},
	"customTemplates": [
		{
			"name": "template-default",
			"title": "Default (header & footer)",
			"postTypes": [ "page" ]
		},
		{
			"name": "template-white",
			"title": "White (white header & footer)",
			"postTypes": [ "page" ]
		},
		{
			"name": "template-about-home",
			"title": "About home (with About nav)",
			"postTypes": [ "page" ]
		},
		{
			"name": "template-about",
			"title": "About subpage (white, with About subpage nav)",
			"postTypes": [ "page" ]
		},
		{
			"name": "template-privacy",
			"title": "Privacy (white, with Privacy nav)",
			"postTypes": [ "page" ]
		},
		{
			"name": "template-download",
			"title": "Download (with Download nav)",
			"postTypes": [ "page" ]
		},
		{
			"name": "template-education-home",
			"title": "Education home (white-on-black, with Education nav)",
			"postTypes": [ "page" ]
		},
		{
			"name": "template-education",
			"title": "Education subpage (white-on-black, with Education subpage nav)",
			"postTypes": [ "page" ]
		}
	]
}
